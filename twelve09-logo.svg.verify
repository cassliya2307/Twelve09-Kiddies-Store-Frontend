<svg width="960" height="460" viewBox="0 0 960 460" fill="none" xmlns="http://www.w3.org/2000/svg">

  <defs>
    <linearGradient id="twGlow" x1="180" x2="730" y1="100" y2="260" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#9BCE34" />
      <stop offset="0.3" stop-color="#FF7A2F" />
      <stop offset="0.62" stop-color="#EC2C73" />
      <stop offset="1" stop-color="#80C63C" />
    </linearGradient>

    <filter id="shadow" x="-20%" y="-20%" width="160%" height="180%">
      <feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#000000" flood-opacity="0.9" />
    </filter>
  </defs>

  <!-- decorative frame around wordmark -->
  <path d="M90 260C70 250 72 220 110 210C125 202 128 190 128 188C142 195 150 198 166 198C196 196 210 180 209 160C207 150 195 142 180 144" stroke="#8BCE35" stroke-width="5" fill="none" opacity="0.9" />
  <path d="M116 316C155 300 170 270 165 246C160 228 150 210 132 205" stroke="#8BCE35" stroke-width="5" fill="none" opacity="0.8" />

  <!-- Three playful decorative side motifs -->
  <circle cx="110" cy="100" r="10" fill="#94D83D" />
  <circle cx="160" cy="120" r="8" fill="#FF6B2B" />
  <path d="M182 120C190 120 195 124 196 130C188 130 184 134 180 138C178 132 177 128 182 120" fill="#A7D847" />
  <path d="M710 92C730 95 739 110 738 120C725 114 718 118 710 122C700 116 704 106 710 92" fill="#8BC43A" />

  <!-- main stacked wording style similar to reference -->
  <text x="480" y="200" text-anchor="middle" font-family="Arial Rounded MT Bold, Arial" font-size="140" font-weight="900" fill="url(#twGlow)" filter="url(#shadow)">Twelve</text>

  <!-- small green 09 circle on right of Twelve -->
  <circle cx="720" cy="150" r="34" fill="#8DCE3C" stroke="#FFFFFF" stroke-width="2" />
  <text x="720" y="160" text-anchor="middle" font-family="Arial Rounded MT Bold, Arial" font-size="30" font-weight="900" fill="#1C6930">09</text>

  <!-- line below -->
  <text x="480" y="280" text-anchor="middle" font-family="Arial Rounded MT Bold, Arial" font-size="65" font-weight="900" fill="#A6D141">Kids Store</text>

  <!-- tagline -->
  <text x="480" y="330" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="700" fill="#F8EFE1">A one-stop shop for your little ones</text>

  <!-- decorative bottom hints -->
  <path d="M250 312C280 335 310 336 330 330" stroke="#A7D64D" stroke-width="3" fill="none" opacity="0.8" />
  <path d="M640 318C668 330 700 330 720 316" stroke="#E95B5B" stroke-width="3" fill="none" opacity="0.8" />
</svg>
